# API
PORT=3000
DATABASE_URL=postgres://hookyard:hookyard@localhost:5432/hookyard
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info

# Segredo HMAC por source: WEBHOOK_SECRET_<SOURCE em maiúsculas>
WEBHOOK_SECRET_MERCADOLIVRE=troque-este-segredo
WEBHOOK_SECRET_SHOPEE=outro-segredo

# Worker
MAX_ATTEMPTS=5
BACKOFF_BASE_MS=1000
BACKOFF_FACTOR=4
WORKER_CONCURRENCY=5
WORKER_METRICS_PORT=9464
RECONCILE_INTERVAL_MS=30000
RECONCILE_MIN_AGE_MS=10000

# Processador: simulated | http
PROCESSOR=simulated
SIMULATED_FAILURE_RATE=0.3
SIMULATED_LATENCY_MS=200
# PROCESSOR_HTTP_URL=http://erp.local/pedidos
# PROCESSOR_HTTP_TIMEOUT_MS=5000
